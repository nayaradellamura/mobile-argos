{
  "name": "argos-rules-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Testes das regras de seguranca do Firestore/Storage (fho-argos) no emulador.",
  "type": "commonjs",
  "scripts": {
    "test": "mocha --timeout 20000 --exit \"test/**/*.test.js\"",
    "test:emu": "firebase emulators:exec --config ../firebase.json --project demo-argos-rules --only firestore,storage \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "mocha": "^12.0.3"
  }
}
