# Copie para .env (rodando local com `npm start` + emulador, ou variáveis do
# seu shell) ou configure como env vars do serviço no deploy do Cloud Run.
# Nenhuma dessas é secreta — a autenticação com o Firebase/Vertex AI vem da
# identidade do serviço (service account do Cloud Run), não de chave aqui.

GOOGLE_CLOUD_PROJECT=fho-argos
GOOGLE_CLOUD_LOCATION=us-central1
ARGOS_STORAGE_BUCKET=fho-argos.firebasestorage.app
LAUDO_GEMINI_MODEL=gemini-2.5-flash

# Só necessário rodando localmente FORA do Cloud Run — lá o Chromium do apt
# já fica em /usr/bin/chromium (ver Dockerfile).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
