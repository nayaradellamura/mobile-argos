# Copie para functions/.env e preencha. O Firebase CLI lê esse arquivo no
# deploy (`firebase deploy --only functions`) e no emulador — são os params
# `defineString(...)` de functions/index.js. Nenhum valor aqui é segredo;
# os segredos de verdade ficam no Secret Manager (ver o fim do arquivo).

# URL do agente ADK no Cloud Run (adk_agents/scripts/deploy_cloud_run.ps1). Pegue com:
#   gcloud run services describe argos-adk --project=fho-argos --region=us-central1 --format="value(status.url)"
ARGOS_ADK_SERVICE_URL=https://argos-adk-xxxxxxxxxx-uc.a.run.app

# Rota de laudo técnico do laudo-service (services/laudo-service). Vazia = laudo
# fica com status "erro" no sinistro. Pegue a base com:
#   gcloud run services describe laudo-service --project=fho-argos --region=us-central1 --format="value(status.url)"
LAUDO_SERVICE_URL=https://laudo-service-xxxxxxxxxx-uc.a.run.app/gerar-laudo

# Rota de orçamento aprovado — mesmo serviço, outra rota. Vazia = orçamento fica com status "erro".
ORCAMENTO_SERVICE_URL=https://laudo-service-xxxxxxxxxx-uc.a.run.app/gerar-orcamento-aprovado

# Fila do Cloud Tasks que enfileira a geração dos PDFs (criada no passo 5 do README do laudo-service).
LAUDO_TASKS_QUEUE=laudo-tecnico

# Região da fila do Cloud Tasks.
LAUDO_TASKS_LOCATION=us-central1

# Service account que o Cloud Tasks usa pra autenticar (OIDC) no laudo-service (precisa de roles/run.invoker).
LAUDO_INVOKER_SERVICE_ACCOUNT=laudo-invoker@fho-argos.iam.gserviceaccount.com

# Opcional: modelo Gemini da transcrição/revisão de áudio (default gemini-3.8-flash, endpoint "global").
# GEMINI_REVIEW_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Segredos (defineSecret) — NÃO vão neste arquivo. Configure no Secret Manager:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN        # token do bot (@BotFather)
#   firebase functions:secrets:set TELEGRAM_CHAT_ID          # chat que recebe alertas/resumos
#   firebase functions:secrets:set MONITORING_WEBHOOK_TOKEN  # token compartilhado com o canal webhook do Cloud Monitoring
# No emulador, use functions/.secret.local (já ignorado pelo *.local do .gitignore)
# com as mesmas chaves, ex.: TELEGRAM_BOT_TOKEN=123456:ABC...
