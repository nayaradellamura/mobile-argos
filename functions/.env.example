# Copie para "functions/.env" e preencha com a URL do Cloud Run do agente ADK.
# Pegue com:
#   gcloud run services describe argos-adk --project=fho-argos --region=us-central1 --format="value(status.url)"
# Sem barra no final.
ARGOS_ADK_SERVICE_URL=https://argos-adk-XXXXXXXX-uc.a.run.app

# Geração de laudo técnico (ver services/laudo-service/README.md para o
# runbook completo de deploy). Pegue a URL com:
#   gcloud run services describe laudo-service --project=fho-argos --region=us-central1 --format="value(status.url)"
LAUDO_SERVICE_URL=https://laudo-service-XXXXXXXX-uc.a.run.app/gerar-laudo
LAUDO_TASKS_QUEUE=laudo-tecnico
LAUDO_TASKS_LOCATION=us-central1
# Service account com permissão roles/run.invoker no laudo-service — é quem
# o Cloud Tasks usa pra autenticar (OIDC) a chamada.
LAUDO_INVOKER_SERVICE_ACCOUNT=laudo-invoker@fho-argos.iam.gserviceaccount.com

# Orçamento aprovado — mesmo Cloud Run do laudo técnico, rota diferente.
# Reaproveita LAUDO_TASKS_QUEUE/LOCATION/INVOKER_SERVICE_ACCOUNT acima.
ORCAMENTO_SERVICE_URL=https://laudo-service-XXXXXXXX-uc.a.run.app/gerar-orcamento-aprovado
