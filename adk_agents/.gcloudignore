# O que NUNCA pode entrar na imagem do Cloud Run.
# .env é o mais crítico: ele contém FIRESTORE_EMULATOR_HOST=localhost:8080,
# que quebraria todas as tools de Firestore em produção.
.env
.env.*
!.env.example
.venv
__pycache__/
*.pyc
.adk/
*.db

# Não fazem parte do runtime do agente:
scripts/
ui_teste/
README.md
*/README.md
.git/
.gitignore

# Testes e avaliacoes nao fazem parte do runtime.
tests/
eval/
*/eval/
