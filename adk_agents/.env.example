# Copie para ".env" (não versionar o .env de verdade) ou exporte estas
# variáveis na sessão do terminal antes de rodar o script de simulação.

# Chave gratuita do Google AI Studio (https://aistudio.google.com/apikey)
# — usada em vez de Vertex AI para garantir custo zero na simulação.
GOOGLE_API_KEY=COLE_SUA_CHAVE_AQUI

# Usa a API pública do Gemini (AI Studio) em vez de Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Qualquer valor serve quando FIRESTORE_EMULATOR_HOST está setado — o
# emulador não valida o projeto de verdade.
GOOGLE_CLOUD_PROJECT=demo-argos

# Setado automaticamente pelo script simular_local.ps1 quando o emulador
# do Firestore está no ar.
FIRESTORE_EMULATOR_HOST=localhost:8080
